# Offline development defaults. Export these values in the process environment.
SERIESRAG_EMBEDDING_PROVIDER=development
SERIESRAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SERIESRAG_VECTOR_STORE=in_memory
SERIESRAG_GENERATION_PROVIDER=fake

# External service settings used only when their provider is selected.
SERIESRAG_QDRANT_URL=http://localhost:6333
SERIESRAG_QDRANT_COLLECTION=seriesrag
SERIESRAG_OLLAMA_URL=http://localhost:11434
SERIESRAG_OLLAMA_MODEL=

# Shared application limits and defaults.
SERIESRAG_CONTEXT_MAX_CHARACTERS=4000
SERIESRAG_DEFAULT_TOP_K=5
